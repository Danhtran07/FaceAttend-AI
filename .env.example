APP_ENV=development

POSTGRES_DB=faceattend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

BACKEND_PORT=8000

AI_SERVICE_HOST_PORT=8002
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_PORT=8001

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/faceattend
# Supabase: replace DATABASE_URL with the URI from Dashboard > Connect.
# URL-encode special characters in the password (for example @ becomes %40).
# Example: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
AI_SERVICE_WS_URL=ws://ai-service:8000
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Secret used by the AI service to sign and verify liveness tokens.
JWT_SECRET=change-this-ai-service-secret

# Use the frontend origin in shared/staging environments instead of *.
CORS_ORIGINS=http://localhost:5173
